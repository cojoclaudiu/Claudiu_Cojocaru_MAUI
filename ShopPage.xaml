<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClaudiuCojocaruLab7.ShopPage"
             Title="ShopPage">

    <StackLayout Margin="20">
        <Editor Placeholder="Enter shop name"
                Text="{Binding ShopName}"
                HeightRequest="50" />

        <Editor Placeholder="Enter shop address"
                Text="{Binding Adress}"
                HeightRequest="50" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Text="Save Shop"
                    Clicked="OnSaveButtonClicked"/>

            <Button Grid.Column="1"
                    Text="Show on Map"
                    Clicked="OnShowMapButtonClicked"/>
        </Grid>
        
        <Button Text="Delete Shop"
                BackgroundColor="LightCoral"
                Clicked="OnDeleteButtonClicked"/>
    </StackLayout>
</ContentPage>